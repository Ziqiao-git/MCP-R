# ============================================
# MCP_INFO_MGR Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# === Required - Smithery MCP Registry ===
SMITHERY_API_KEY=your_smithery_api_key_here
SMITHERY_REGISTRY_BASE=https://registry.smithery.ai
SMITHERY_PROFILE=your_smithery_profile_here

# === Optional - LLM Evaluation (test_all_tools.py) ===
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Optional - Specific Tool Tests ===
# GitHub
GITHUB_TOKEN=your_github_pat_here

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Browserbase
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Bright Data
BRIGHTDATA_TOKEN=your_brightdata_token_here

# Financial Modeling Prep
FMP_API_KEY=your_fmp_api_key_here
FMP_CONFIG_BASE64=your_fmp_config_base64_here

# E2B Code Sandbox
E2B-API-KEY=your_e2b_api_key_here
